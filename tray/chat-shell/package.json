{
  "name": "myportal-tray-chat",
  "productName": "MyPortal Chat",
  "version": "1.0.0",
  "description": "Dedicated chat window for the MyPortal Tray App. Opens the MyPortal support chat in an isolated app window, completely separate from the user's browser sessions.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "build:mac": "npm run build:icons:mac && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --x64 --arm64",
    "build:icons:mac": "bash ../scripts/build-macos-icons.sh"
  },
  "build": {
    "appId": "io.myportal.tray.chat",
    "productName": "MyPortal Chat",
    "executableName": "myportal-tray-chat",
    "copyright": "Copyright © MyPortal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "myportal-tray-chat"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "identity": null
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "tar": "7.5.22",
    "minimatch@3.1.5": {
      ".": "5.1.9",
      "brace-expansion": "2.1.4"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@9.0.9": {
      "brace-expansion": "2.1.4"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
