<?xml version="1.0" encoding="UTF-8"?>
<!--
  MyPortal Tray App — Windows setup.exe (WiX v7 Burn bundle)

  Wraps a company-specific myportal-tray.msi in a standard setup wizard so end
  users get a familiar "Install" window. Built by the MyPortal build agent
  (tray/build-agent/MyPortalBuildAgent.ps1); it is not part of the release CI.

  Build with:
    wix build -acceptEula wix7 myportal-tray-bundle.wxs -arch x64 `
      -ext WixToolset.BootstrapperApplications.wixext `
      -d "MsiPath=C:\path\to\myportal-tray.msi" -d "ProductVersion=1.2.3" `
      -o MyPortal-Tray-Setup.exe

  The MSI already carries the portal URL and install token as property
  defaults, so the bundle passes nothing to it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle
    Name="MyPortal Tray"
    Manufacturer="MyPortal"
    Version="$(var.ProductVersion)"
    UpgradeCode="6E0B2D84-3C1A-4B7F-9D25-8F4A1C7E3B90"
    AboutUrl="https://github.com/bradhawkins85/MyPortal">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        Theme="hyperlinkLicense"
        LicenseUrl="https://github.com/bradhawkins85/MyPortal/blob/main/LICENSE"
        SuppressOptionsUI="yes"
        SuppressRepair="yes" />
    </BootstrapperApplication>

    <Chain>
      <MsiPackage SourceFile="$(var.MsiPath)" Visible="no" />
    </Chain>
  </Bundle>
</Wix>
