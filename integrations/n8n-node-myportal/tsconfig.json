{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "lib": [
      "es2020"
    ],
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16"
  },
  "include": [
    "credentials/**/*.ts",
    "nodes/**/*.ts"
  ]
}
