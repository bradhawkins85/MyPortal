# Templated systemd service for two-instance MyPortal deployments.
# Used together with deploy/nginx/myportal-bluegreen.conf — see
# docs/zero_downtime_upgrades.md.
#
# Instance names map to ports as:
#   blue  -> 8001
#   green -> 8002
#
# Install with:
#   cp deploy/systemd/myportal@.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now myportal@blue.service
#   systemctl enable --now myportal@green.service
#
# Set MYPORTAL_INSTANCE_PORT in /etc/myportal.<instance>.env to override
# the default port mapping below.  Each instance file should also pin
# APP_INSTANCE_ID (read by app/services/singleton_jobs.py) so log lines
# clearly identify which instance fired each job.

[Unit]
Description=MyPortal customer portal (%i instance)
After=network-online.target mysql.service redis.service
Wants=network-online.target

[Service]
Type=notify
User=myportal
Group=myportal
EnvironmentFile=/etc/myportal.env
EnvironmentFile=-/etc/myportal.%i.env
# Default port mapping is selected by ExecStart. Override it with
# MYPORTAL_INSTANCE_PORT in /etc/myportal.<instance>.env.
Environment=APP_INSTANCE_ID=%i
ExecStart=/bin/sh -ec 'case %i in blue) default_port=8001;; green) default_port=8002;; *) echo "Invalid MyPortal instance %i; use myportal@blue.service or myportal@green.service (one .service suffix)." >&2; exit 64;; esac; release=$$(readlink -f /opt/myportal/instances/%i); test -n "$$release"; cd "$$release"; exec "$$release/.venv/bin/python" -m uvicorn app.main:app --host 127.0.0.1 --port "$${MYPORTAL_INSTANCE_PORT:-$$default_port}" --workers 2'
# Graceful reload: SIGHUP causes uvicorn to gracefully restart workers
# without dropping accepted connections.
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Release immutability is enforced by ownership and read-only filesystem modes.
# Do not bind-mount the release tree read-only: upload paths inside each release
# are symlinks into the writable shared tree and must remain writable.
ReadOnlyPaths=/opt/myportal/instances
ReadWritePaths=/opt/myportal/shared

[Install]
WantedBy=multi-user.target
